# SwasthyaVaani Backend Configuration

# Application
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="SwasthyaVaani API"

# Security
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Supabase PostgreSQL / Local SQLite fallback)
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# For Local SQLite: sqlite:///./swasthyavaani.db
DATABASE_URL=sqlite:///./swasthyavaani.db

# Supabase Cloud Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=medical-documents

# Private document processing
# Current checkpoint: local private storage only; Supabase document storage is pending.
DOCUMENT_STORAGE_DIR=./private_uploads
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_MAX_PAGE_COUNT=20

# OCR provider: mock is deterministic; paddle uses the optional pinned CPU OCR runtime.
PROVIDER_OCR=mock

# External AI Provider Keys (Optional in Mock Mode)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash
DOCUMENT_EXTRACTOR_PROVIDER=groq
GROQ_API_KEY=
GROQ_DOCUMENT_MODEL=openai/gpt-oss-20b
SARVAM_API_KEY=
BHASHINI_API_KEY=
